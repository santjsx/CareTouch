<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Royal Sapphire to Midnight Indigo Diagonal Gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="15"
                android:startY="10"
                android:endX="95"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#2563EB" />
                <item android:offset="0.45" android:color="#1D4ED8" />
                <item android:offset="0.8" android:color="#1E1B4B" />
                <item android:offset="1.0" android:color="#0F172A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Top-Left Light Halo Glow -->
    <path
        android:pathData="M10,10 A50,50 0 0,0 90,90 A50,50 0 0,0 10,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="36"
                android:centerY="30"
                android:gradientRadius="48"
                android:type="radial">
                <item android:offset="0.0" android:color="#40FFFFFF" />
                <item android:offset="0.6" android:color="#1560A5FA" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Ambient Bottom-Right Warm Violet Reflection -->
    <path
        android:pathData="M40,40 A50,50 0 0,0 108,108 A50,50 0 0,0 40,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="85"
                android:centerY="85"
                android:gradientRadius="35"
                android:type="radial">
                <item android:offset="0.0" android:color="#30818CF8" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
